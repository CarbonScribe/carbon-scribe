# Anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5

# Service
PORT=4500
NODE_ENV=development
LOG_LEVEL=info

# Internal service-to-service auth (issue #579): each caller signs its own
# short-lived HS256 JWT with its own secret and sends it as
# `Authorization: Bearer <token>`. Register one secret per trusted caller
# below — rotating or leaving one blank revokes just that caller, without
# touching the others.
CORPORATE_PLATFORM_JWT_SECRET=
PROJECT_PORTAL_JWT_SECRET=

# Upstream services allowed to manage human approvals. Each must authenticate
# the human reviewer and validate their approval permission before forwarding.
# Empty by default, which denies all approval queue access.
APPROVAL_REVIEWER_SERVICES=

# Durable approved-action outbox polling and bounded retry policy.
APPROVAL_OUTBOX_POLL_INTERVAL_MS=3000
APPROVAL_OUTBOX_BATCH_SIZE=20
APPROVAL_OUTBOX_MAX_ATTEMPTS=5
APPROVAL_OUTBOX_LOCK_TIMEOUT_MS=60000
APPROVAL_OUTBOX_RETRY_BASE_MS=1000
APPROVAL_OUTBOX_RETRY_MAX_MS=60000

# Credential agent-service uses when calling corporate-platform-backend.
# Register this secret for issuer "agent-service" in the backend's service-token guard.
AGENT_SERVICE_JWT_SECRET=

# Upstream backends this service calls as tool providers
CORPORATE_PLATFORM_BASE_URL=http://localhost:3000
PROJECT_PORTAL_BASE_URL=http://localhost:8080

# agent-service's own Postgres database — currently just the audit log
# (agent_audit_log table, see migrations/001_create_agent_audit_log.sql,
# applied automatically at startup)
AGENT_AUDIT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_service
