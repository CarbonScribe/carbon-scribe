{
  "name": "agent-service",
  "version": "0.0.1",
  "description": "Standalone agentic AI service for CarbonScribe \u2014 discovery, PDD drafting, compliance-report drafting, and alert-triage agents that call into corporate-platform and project-portal as tools.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node init && tsc -p tsconfig.json",
    "start": "node init && node dist/main.js",
    "start:dev": "node init && tsx watch src/main.ts",
    "generate:openapi": "tsx src/openapi/generate.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "loadtest": "tsx loadtest/run.ts",
    "test:load": "tsx loadtest/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "axios": "^1.21.1",
    "dotenv": "^17.3.1",
    "express": "^4.22.3",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "autocannon": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "body-parser": "^1.20.9"
  }
}
